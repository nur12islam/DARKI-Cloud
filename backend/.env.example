NODE_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/darki_cloud
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_STORAGE_CHAT_ID=replace-with-private-storage-chat-id
TELEGRAM_CLIENT_ID=replace-with-telegram-client-id
TELEGRAM_CLIENT_SECRET=replace-with-telegram-client-secret
TELEGRAM_OIDC_REDIRECT_URI=https://your-domain.example/api/v1/auth/telegram/callback
TELEGRAM_APP_REDIRECT_URI=darkicloud://auth
